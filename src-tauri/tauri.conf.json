{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Drive",
  "version": "0.1.0",
  "identifier": "com.davidngugi.dailydrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daily Drive",
        "width": 980,
        "height": 760,
        "minWidth": 680,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/videos/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4N0FBMkU5MTYzNkMxRjQKUldUMHdUWVc2YUo2bUgwaFY5eUJFTjJvQ0kvZitRdWxLZ0RILzdybmI4REZZUFF6ek9zL05UMDkK",
      "endpoints": [
        "https://github.com/DavidNgugi/daily-drive/releases/latest/download/latest.json"
      ]
    }
  }
}
